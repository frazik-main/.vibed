{
  "name": "vibed-player",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "author": "Vibed",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "web:dev": "vite --host 127.0.0.1",
    "desktop:preview": "npm run build && electron .",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win portable",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run"
  },
  "build": {
    "appId": "com.vibed.player",
    "productName": "Vibed",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/fflate/**/*",
      "node_modules/react/umd/**/*",
      "node_modules/react-dom/umd/**/*",
      "node_modules/htm/dist/**/*",
      "node_modules/three/build/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "Vibed.exe"
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "htm": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  }
}
